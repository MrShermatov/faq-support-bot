# Gemini API Key (obtain from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Default model (defaults to gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Optional: Set to 1 for offline deterministic mock mode (for automated CI without API key)
# MOCK_GEMINI=0
